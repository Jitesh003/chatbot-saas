    "publish": false
  },
  "dependencies": {
    "@langchain/core": "^1.4.2",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/textsplitters": "^1.0.2",
    "hono": "4.11.1",
    "pg": "^8.23.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
